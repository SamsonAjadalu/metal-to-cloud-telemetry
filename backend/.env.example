# Copy to .env or set in compose / shell (see repo root .env.example for full stack).

# postgresql://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgresql://robot_admin:secret_password@db:5432/metal_to_cloud

# Comma-separated browser origins that may call this API (dashboard :3000 / Vite :5173 — not :8000).
# Production: include your public UI, e.g. http://203.0.113.10:3000
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
