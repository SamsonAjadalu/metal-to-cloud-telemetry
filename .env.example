
# Database Credentials
DB_NAME=metal_to_cloud
DB_USER=robot_admin
DB_PORT=5432
DB_PASSWORD=your_password_managed_via_docker_secrets

# API — comma-separated browser origins allowed to call FastAPI REST (the *dashboard* URL, not :8000).
# Local:
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
# Production (example — use your droplet IP or DNS + port 3000):
# CORS_ALLOW_ORIGINS=http://203.0.113.10:3000

# Frontend build (Vite): HTTP origin of this API, no trailing slash (see frontend/.env.example).
VITE_API_BASE_URL=http://localhost:8000

# Telemetry Variables
BACKEND_BASE_URL=ws://localhost:8000
